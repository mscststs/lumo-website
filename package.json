{
  "name": "lumo-website",
  "description": "Lumo brand website — product home, docs, and release notes.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "postbuild": "node scripts/build-sitemap.mjs",
    "preview": "wrangler pages dev build/client --port 4173",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler pages deploy build/client --project-name lumo-website"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-router/node": "^8.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.6.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.10",
    "react-router": "^8.5.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
